# Runtime data -- the log and its snapshots are yours, not the repo's.
data/
*.db
*.db-wal
*.db-shm

# Downloaded models. yolo11s is committed deliberately: no pre-exported ONNX
# is published for it, and exporting one needs PyTorch, which is a painful
# dependency to add to a Pi just to convert a file once.
models/
*.onnx
*.pt
!models/yolo11s.onnx

# Local config
config.yaml
config.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Sample images are yours, not the repo's.
samples/*
!samples/README.md
